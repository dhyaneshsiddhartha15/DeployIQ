      "type": "object",
      "properties": {
        "user": {
          "$ref": "#/definitions/v1User"
        },
        "role": {
          "type": "string"
        }
      }
    },
    "v1Optimization": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "readOnly": true
        },
        "repoName": {
          "type": "string"
        },
        "detectedStack": {
          "type": "string"
        },
        "originalEstSizeMB": {
          "type": "integer",
          "format": "int32"
        },
        "optimizedEstSizeMB": {
          "type": "integer",
          "format": "int32"
        },
        "rulesApplied": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "readOnly": true
        },
        "savingsPercent": {
          "type": "number",
          "format": "double",
          "description": "savings_percent is derived, for the dashboard's headline number.",
          "readOnly": true
        },
        "org": {
          "type": "string",
          "description": "org is the organisation slug the report was sent into, if any."
        },
        "reportedBy": {
          "type": "string",
          "description": "reported_by is the reporter's display name.",
          "readOnly": true
        }
      },
      "description": "Optimization is one recorded run. Size fields are estimates (Phase 1.5) and\nare named so. JSON names keep the exact casing of the Phase 4.5 example body."
    },
    "v1Org": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "readOnly": true
        },
        "slug": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "settings": {
          "$ref": "#/definitions/v1OrgSettings"
        },
        "role": {
          "type": "string",
          "description": "role is the caller's role, when listing their own organisations."
        }
      }
    },
    "v1OrgSettings": {
      "type": "object",
      "properties": {
        "storagePerGBMonthUSD": {
          "type": "number",
          "format": "double"
        },
        "transferPerGBUSD": {
          "type": "number",
          "format": "double"
        },
        "pullsPerDay": {
          "type": "number",
          "format": "double"
        },
        "versionsKept": {
          "type": "number",
          "format": "double"
        }
      }
    },
    "v1OrgSummary": {
      "type": "object",
      "properties": {
        "org": {
          "$ref": "#/definitions/v1Org"
        },
        "repos": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1RepoSummary"
          }
        },
        "runs": {
          "type": "integer",
          "format": "int32"
        },
        "currentMB": {
          "type": "number",
          "format": "double"
        },
        "optimizedMB": {
          "type": "number",
          "format": "double"
        },
        "savedMB": {
          "type": "number",
          "format": "double"
        },
        "avgSavedPercent": {
          "type": "number",
          "format": "double"
        },
        "monthlySavedUSD": {
          "type": "number",
          "format": "double"
        },
        "members": {
          "type": "integer",
          "format": "int32"
        }
      }
    },
    "v1RepoSummary": {
      "type": "object",
      "properties": {
        "repoName": {
          "type": "string"
        },
        "latest": {
          "$ref": "#/definitions/v1Optimization"
        },
        "runs": {
          "type": "integer",
          "format": "int32"
        },
        "reportedBy": {
          "type": "string"
        },
        "monthlySavedUSD": {
          "type": "number",
          "format": "double"
        }
      }
    },
    "v1User": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "readOnly": true
        },
        "githubId": {
          "type": "string"
        },
        "login": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "plan": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "name": {
          "type": "string"
        },
        "provider": {
          "type": "string",
          "description": "provider is \"github\" or \"oidc\"."
        }
      },
      "description": "User is the dashboard account. There is no password field, by design\n(Phase 3.1: GitHub OAuth only, no password liability)."
    }
  }
}
