        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/OrgsServiceInviteMemberBody"
            }
          }
        ],
        "tags": [
          "OrgsService"
        ]
      }
    },
    "/api/v1/orgs/{slug}/members/{userId}": {
      "delete": {
        "summary": "RemoveMember removes a member (admins), or the caller themself (leave).",
        "operationId": "OrgsService_RemoveMember",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1Empty"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "OrgsService"
        ]
      },
      "patch": {
        "summary": "UpdateMember changes a member's role. Admins only; the last admin cannot\nbe demoted.",
        "operationId": "OrgsService_UpdateMember",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1Member"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/OrgsServiceUpdateMemberBody"
            }
          }
        ],
        "tags": [
          "OrgsService"
        ]
      }
    },
    "/api/v1/orgs/{slug}/optimizations": {
      "get": {
        "summary": "ListOrgOptimizations is every report sent into the organisation.",
        "operationId": "OrgsService_ListOrgOptimizations",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1ListOptimizationsResponse"
            }
          },
          "default": {
