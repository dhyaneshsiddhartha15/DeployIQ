              "$ref": "#/definitions/v1OrgSettings"
            }
          }
        ],
        "tags": [
          "OrgsService"
        ]
      }
    },
    "/api/v1/orgs/{slug}/summary": {
      "get": {
        "summary": "GetOrgSummary is the organisation dashboard: per-repo latest results,\ntotals and the estimated monthly cost saving. Members only.",
        "operationId": "OrgsService_GetOrgSummary",
