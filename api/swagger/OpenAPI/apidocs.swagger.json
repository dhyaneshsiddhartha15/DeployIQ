        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1CreateOrgRequest"
            }
          }
        ],
        "tags": [
          "OrgsService"
        ]
      }
    },
    "/api/v1/orgs/{slug}/invitations/{id}": {
      "delete": {
        "summary": "DeleteInvitation withdraws a pending invitation. Admins only.",
