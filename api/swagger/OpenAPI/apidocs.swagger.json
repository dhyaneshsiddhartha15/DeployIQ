  "paths": {
    "/api/v1/me": {
      "get": {
        "operationId": "UsersService_GetMe",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1User"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "tags": [
          "UsersService"
        ]
      }
    },
    "/api/v1/optimizations": {
      "get": {
        "summary": "ListOptimizations returns the caller's history, most recent first,\noptionally filtered to one repository (GET /api/v1/optimizations?repo=).",
        "operationId": "OptimizationsService_ListOptimizations",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1ListOptimizationsResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "repo",
            "description": "repo filters to one repository name. Empty means all of the caller's.",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "limit",
            "description": "limit caps the result count: default 50, maximum 500.",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32"
          }
        ],
        "tags": [
          "OptimizationsService"
        ]
      },
      "post": {
        "summary": "CreateOptimization stores one opt-in report from `doiq -report`.",
        "operationId": "OptimizationsService_CreateOptimization",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1Optimization"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "description": "{\"repoName\": \"company/backend\", \"detectedStack\": \"node\",\n   \"originalEstSizeMB\": 640, \"optimizedEstSizeMB\": 118,\n   \"rulesApplied\": [\"multi-stage-build\", \"alpine-base\", \"prod-only-deps\"]}\n\nThe client never supplies id, owner or timestamp.",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1CreateOptimizationRequest"
            }
          }
        ],
        "tags": [
          "OptimizationsService"
        ]
      }
    },
    "/api/v1/orgs": {
      "get": {
        "summary": "ListMyOrgs returns the organisations the caller belongs to.",
        "operationId": "OrgsService_ListMyOrgs",
        "responses": {
          "200": {
            "description": "A successful response.",
