  "definitions": {
    "OrgsServiceInviteMemberBody": {
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "description": "Exactly one of email or login (a GitHub username)."
        },
        "login": {
          "type": "string"
        },
        "role": {
          "type": "string"
        }
      }
    },
    "OrgsServiceUpdateMemberBody": {
      "type": "object",
      "properties": {
        "role": {
          "type": "string"
        }
      }
    },
    "protobufAny": {
      "type": "object",
      "properties": {
        "@type": {
          "type": "string"
        }
      },
      "additionalProperties": {}
    },
    "rpcStatus": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "format": "int32"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/protobufAny"
          }
        }
      }
    },
    "v1CreateOptimizationRequest": {
      "type": "object",
      "properties": {
        "repoName": {
          "type": "string"
        },
        "detectedStack": {
          "type": "string"
        },
        "originalEstSizeMB": {
          "type": "integer",
          "format": "int32"
        },
        "optimizedEstSizeMB": {
          "type": "integer",
          "format": "int32"
        },
        "rulesApplied": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "org": {
          "type": "string",
          "description": "org reports into an organisation (its slug); the caller must be a member."
        }
      },
      "description": "{\"repoName\": \"company/backend\", \"detectedStack\": \"node\",\n   \"originalEstSizeMB\": 640, \"optimizedEstSizeMB\": 118,\n   \"rulesApplied\": [\"multi-stage-build\", \"alpine-base\", \"prod-only-deps\"]}\n\nThe client never supplies id, owner or timestamp.",
      "title": "CreateOptimizationRequest is the Phase 4.5 request body:",
      "required": [
        "repoName",
        "detectedStack",
        "originalEstSizeMB",
        "optimizedEstSizeMB"
      ]
    },
    "v1CreateOrgRequest": {
      "type": "object",
      "properties": {
        "slug": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "slug",
        "name"
      ]
    },
    "v1Empty": {
      "type": "object",
      "description": "Empty is the request/response type for calls that carry no payload."
    },
    "v1Invitation": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "login": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "v1InviteMemberResponse": {
      "type": "object",
      "properties": {
        "member": {
          "$ref": "#/definitions/v1Member",
          "description": "member is set when the user already had an account and was added now;\ninvitation when they will join at their first login."
        },
        "invitation": {
          "$ref": "#/definitions/v1Invitation"
        }
      }
    },
    "v1ListMembersResponse": {
      "type": "object",
      "properties": {
        "members": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1Member"
          }
        },
        "invitations": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1Invitation"
          }
        }
      }
    },
    "v1ListOptimizationsResponse": {
      "type": "object",
      "properties": {
