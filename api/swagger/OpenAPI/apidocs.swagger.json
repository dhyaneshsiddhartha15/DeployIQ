          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1Optimization"
          }
        }
      }
    },
    "v1ListOrgsResponse": {
      "type": "object",
      "properties": {
        "orgs": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1Org"
          }
        }
      }
    },
