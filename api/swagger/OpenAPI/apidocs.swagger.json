        },
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "OrgsService"
        ]
      },
      "post": {
        "summary": "InviteMember adds a user now if they have an account, else records an\ninvitation claimed at their first login. Admins only.",
        "operationId": "OrgsService_InviteMember",
