# Keep the build context small and keep local secrets out of the image.
.git
.github
.golangci.yml
bin/
dist/
docs/
testdata/
*.md
.env
.env*
configs/*.local.yml

# The dashboard sources are needed (the image builds them); its local
# dependencies and build output are not.
web/node_modules/
web/dist/
web/coverage/
